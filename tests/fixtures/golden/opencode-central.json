{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "llm-glue": {
      "name": "LLM Glue",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://litellm.example.test/v1",
        "apiKey": "test-inference-key"
      },
      "models": {
        "qwen-model": {
          "modelID": "llm-glue-qwen-model",
          "name": "Qwen Test",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "temperature": true,
            "reasoning": {
              "supported": true,
              "toggle": true
            }
          },
          "family": "qwen",
          "limit": {
            "context": 65536
          },
          "variants": [
            {
              "id": "thinking-on",
              "body": {
                "enable_thinking": true,
                "temperature": 0.6
              }
            }
          ]
        }
      }
    }
  }
}
