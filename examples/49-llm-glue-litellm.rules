// Allow the fixed LLM Glue service account to restart only the configured
// root-owned LiteLLM activation unit. Install as root under
// /etc/polkit-1/rules.d after replacing the unit name if necessary.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "llm-glue-litellm-compose.service" &&
        action.lookup("verb") == "restart" &&
        subject.user == "llm-glue") {
        return polkit.Result.YES;
    }
});
